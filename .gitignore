dist/
build/
out/
.cache/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors & OS cruft
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
